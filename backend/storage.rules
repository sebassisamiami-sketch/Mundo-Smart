rules_version = '2';

// Reglas de Firebase Storage para Mundo Smart.
// Publícalas en: Firebase Console → Storage → Reglas → Publicar.
//
// Qué hacen:
//  - Las fotos de productos (carpeta /products) son PÚBLICAS para que la tienda las muestre.
//  - Solo tu correo de administrador puede SUBIR, cambiar o borrar fotos.

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sebastian.sisatravel@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Fotos y videos de productos (los sube el administrador desde el panel)
    match /products/{allPaths=**} {
      allow read: if true;
      // Hasta 60 MB por archivo; solo imágenes o videos.
      allow write: if isAdmin()
        && request.resource.size < 60 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if isAdmin();
    }

    // Todo lo demás, bloqueado
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
