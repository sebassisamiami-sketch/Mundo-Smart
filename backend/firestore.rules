rules_version = '2';

// Reglas de seguridad de Firestore para Mundo Smart.
// Publícalas en: Firebase Console → Firestore Database → Reglas → Publicar.
//
// Qué hacen:
//  - La TIENDA (pública) puede CREAR pedidos e intentos de carrito, nada más.
//  - Solo tu correo de administrador puede LEER, editar o borrar.
//  - Así los datos quedan protegidos aunque admin.html sea una página pública.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sebastian.sisatravel@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Pedidos confirmados
    match /orders/{id} {
      allow create: if request.resource.data.total is number
                    && request.resource.data.ref is string;
      allow read, update, delete: if isAdmin();
    }

    // Intentos de carrito / checkout
    match /attempts/{id} {
      allow create: if request.resource.data.total is number;
      allow update: if true;              // la tienda marca "completado"
      allow read, delete: if isAdmin();
    }

    // Contenido editable de la tienda (catálogo, categorías, ajustes, textos legales).
    // La tienda (pública) lo LEE para mostrarse; solo el administrador lo EDITA desde el panel.
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Todo lo demás, bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
